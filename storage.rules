rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Equipe com verificação em duas etapas nesta sessão (ver firestore.rules).
    function isStaff() {
      return request.auth != null
        && (request.auth.token.role == 'seller' || request.auth.token.role == 'admin')
        && (request.auth.token.firebase.get('sign_in_second_factor', null) != null
            || (request.auth.token.firebase.sign_in_provider == 'custom'
                && request.auth.token.get('passkey', false) == true));
    }

    // Imagens de produtos, leitura pública, escrita só vendedor/admin
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      // Apagar foto (delete não tem request.resource): antes caía na regra de
      // envio e era sempre negado, e as fotos trocadas ficavam acumulando.
      allow delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.size < 5 * 1024 * 1024  // 5 MB
        // Só o que o painel gera: toda foto passa por um canvas que regrava
        // em WebP ou JPEG e descarta os metadados (EXIF com GPS). Sem SVG,
        // que pode carregar <script> servido do domínio do Storage.
        && request.resource.contentType.matches('image/(webp|jpeg)');
    }

    // Fotos que o cliente manda ao pedir troca (defeito, peça errada): cada
    // um só envia e lê na própria pasta; a equipe lê todas. O navegador
    // regrava a foto em JPEG (sem EXIF) antes de enviar. Ninguém sobrescreve.
    match /returns/{uid}/{file} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isStaff();
      allow create: if request.auth != null && request.auth.uid == uid && resource == null
        && request.resource.size < 3 * 1024 * 1024  // 3 MB
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isStaff();
    }

    // Bloquear tudo mais
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
