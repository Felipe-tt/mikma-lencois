# Copie para .env.local e preencha só o que for usar. Sem as chaves de uma
# integração, a loja funciona e só aquela parte fica desligada.
# Em produção os valores vêm do Secret Manager, ligados em apphosting.yaml.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://mikma.com.br
# Links dos e-mails de conta (confirmar e-mail, redefinir senha).
NEXT_PUBLIC_APP_URL=https://mikma.com.br
# Endereço impresso na etiqueta de envio (painel → pedido → etiqueta).
NEXT_PUBLIC_STORE_ADDRESS=

# ─── Firebase (navegador) ────────────────────────────────────────────────────
# Firebase Console → Configurações do projeto → Seus apps → app da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Notificações do painel: Cloud Messaging → Certificados push da Web.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Firebase Admin (servidor) ───────────────────────────────────────────────
# Configurações do projeto → Contas de serviço → Gerar nova chave privada.
# A chave vai numa linha só, com \n no lugar das quebras.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Emuladores locais (ver README) ──────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── AbacatePay (PIX e cartão) ───────────────────────────────────────────────
# app.abacatepay.com → Integração. O ambiente (teste/produção) é escolhido
# em /painel/configuracoes, por isso há as duas chaves.
ABACATEPAY_API_KEY=
ABACATEPAY_SANDBOX_API_KEY=
# Chaves públicas (pk_) do cartão no próprio site. Não são segredo.
ABACATEPAY_PUBLIC_KEY=
ABACATEPAY_SANDBOX_PUBLIC_KEY=
# Segredo do webhook (/api/payment/webhook), definido ao criar o webhook.
ABACATEPAY_WEBHOOK_SECRET=

# ─── Frete ───────────────────────────────────────────────────────────────────
# Melhor Envio: só cotação de PAC, SEDEX e Jadlog (não precisa de saldo).
# melhorenvio.com.br → Integrações → Permissões de acesso → Gerar token.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
# Correios API (cotação direta): cws.correios.com.br, cartão de postagem.
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CODIGO_ACESSO=
# Jadlog (cotação direta): solicitar ao comercial da Jadlog.
JADLOG_TOKEN=
JADLOG_ACCOUNT=

# ─── Entrega local: Uber Direct ──────────────────────────────────────────────
# direct.uber.com → Desenvolvedor. Um JSON por ambiente:
# {"clientId":"...","clientSecret":"...","customerId":"...","webhookSecret":"..."}
UBER_DIRECT_CREDS=
UBER_DIRECT_SANDBOX_CREDS=
# Raio de entrega em km (o valor salvo nas configurações do painel tem prioridade).
UBER_DIRECT_RADIUS_KM=10
# Rota desenhada no mapa da entrega. Opcional: sem ela usa o OSRM público.
# openrouteservice.org → Dashboard → API Key.
ORS_API_KEY=

# ─── Rastreio dos Correios: Linketrack ───────────────────────────────────────
# linketrack.com → API.
LINKETRACK_USER=
LINKETRACK_TOKEN=

# ─── E-mail: Resend ──────────────────────────────────────────────────────────
# resend.com → API Keys. O domínio precisa estar verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mikma.com.br
# Recebe as respostas dos clientes (Reply-To) e assina as respostas do painel.
EMAIL_CONTATO_ADDRESS=contato@mikma.com.br
# Resend → Webhooks (e-mails recebidos), para /api/email/inbound.
RESEND_WEBHOOK_SECRET=

# ─── Verificação contra robôs ────────────────────────────────────────────────
# Cloudflare Turnstile (padrão; criado por .github/workflows/turnstile-setup.yml)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# reCAPTCHA v3 (reserva, usado só sem as chaves do Turnstile)
# google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Rate limit: Upstash Redis ───────────────────────────────────────────────
# upstash.com → Redis → banco regional. JSON: {"url":"...","token":"..."}
# Sem ele (ou se o Upstash falhar), o limite cai para a memória do servidor.
UPSTASH_REDIS_CREDS=

# ─── Segredos internos ───────────────────────────────────────────────────────
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tarefas agendadas (/api/cron/*), o mesmo valor vai nos secrets do GitHub.
CRON_SECRET=
# Cookie que deixa a equipe logada passar pela tela de manutenção.
STAFF_SESSION_SECRET=
# Trava de origem: só aceita requisições com este segredo no cabeçalho
# x-mikma-edge (colocado pela Cloudflare). Vazio = sem trava (uso local).
EDGE_SHARED_SECRET=

# ─── Analytics (opcional, só com consentimento de cookies) ───────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Sentry (opcional) ───────────────────────────────────────────────────────
# Sem DSN o Sentry fica desligado. Sentry → Settings → Projects → Client Keys.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Só para enviar sourcemaps no build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
