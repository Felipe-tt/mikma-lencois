rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function hasRole(role) {
      return isAuth() && request.auth.token.role == role;
    }
    function isSellerOrAdmin() {
      return hasRole('seller') || hasRole('admin');
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Seller/admin precisam ler dados do cliente (nome, telefone, endereço)
      // ao visualizar o detalhe de um pedido no painel.
      allow read: if isSelf(uid) || isSellerOrAdmin();

      // WHITELIST de campos que o PRÓPRIO usuário grava pelo SDK (checkout,
      // perfil e preferências do painel). Todo o resto (role, emailVerified,
      // lgpdConsent, createdAt, uid, email...) é só do servidor (Admin SDK).
      // Antes qualquer campo podia ser escrito, então um cliente podia, por
      // exemplo, marcar emailVerified:true ou forjar o próprio lgpdConsent.
      // As chaves 'staffPrefs.x' cobrem o setDoc(merge) com dot-notation.
      function editableKeys() {
        return ['name', 'cpf', 'phone', 'address', 'staffPrefs',
                'staffPrefs.lastYarnCount', 'staffPrefs.lastCategory',
                'staffPrefs.lastSize', 'staffPrefs.lastFabrics'];
      }
      // `keys` = os campos que estão sendo gravados (todos no create, só os
      // alterados no update). Valida tipo e tamanho; nome sem < nem >.
      function validProfile(d, keys) {
        return (!('name' in keys) || (d.name is string && d.name.size() >= 1
                  && d.name.size() <= 100 && !d.name.matches('.*[<>].*')))
            && (!('cpf' in keys) || (d.cpf is string && d.cpf.size() <= 14))
            && (!('phone' in keys) || (d.phone is string && d.phone.size() <= 20))
            && (!('address' in keys) || d.address is map
                  || (d.address is string && d.address.size() <= 500));
      }
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(editableKeys())
        && validProfile(request.resource.data, request.resource.data.keys());
      // Dono: só os campos da whitelist (o que também impede mexer em role).
      // Admin: pode tudo (promoção de role etc.).
      allow update: if (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableKeys())
          && validProfile(request.resource.data,
                          request.resource.data.diff(resource.data).affectedKeys()))
        || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // ── Products (leitura pública, escrita apenas vendedor/admin) ───────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isSellerOrAdmin();
    }

    // ── Inventory ────────────────────────────────────────────────────────────
    match /inventory/{sku} {
      allow read: if true;
      // 'reserved' é gerido só pelo fluxo de pedidos (Admin SDK, que ignora
      // estas regras), o painel de estoque nunca deve poder mexer nele.
      // 'history' só pode crescer (arrayUnion), nunca ser reduzido/apagado.
      allow update: if isSellerOrAdmin()
        && request.resource.data.quantity is number
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.reserved == resource.data.reserved
        && request.resource.data.history.size() >= resource.data.history.size();
      allow create: if isSellerOrAdmin();
      // Variação removida do produto (ProductForm): o painel apaga o SKU.
      // Antes era 'if false' e o deleteDoc falhava em silêncio, deixando o
      // estoque "fantasma" contando na página do produto e no painel. Só
      // sem reserva ativa, pra não quebrar pedido aguardando pagamento.
      allow delete: if isSellerOrAdmin() && resource.data.get('reserved', 0) == 0;
    }

    // ── Carts ────────────────────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isSelf(userId);
    }

    // ── Wishlists (favoritos) ───────────────────────────────────────────────
    match /wishlists/{userId} {
      allow read, write: if isSelf(userId);
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    // Leitura pública (mostrado na página do produto). Criação só via API
    // route (Admin SDK), precisa validar que o pedido é do usuário, está
    // 'delivered' e contém o produto, o que não dá pra expressar com
    // segurança só em regra do Firestore. Edição/exclusão: só admin
    // (moderação de conteúdo abusivo).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if hasRole('admin');
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Comprador lê somente os próprios pedidos
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isSellerOrAdmin()
      );
      // Criação via API route (Admin SDK), cliente nunca escreve direto
      allow create: if false;
      // Nenhuma atualização pelo client SDK: todo o fluxo (status, pagamento,
      // entrega, cancelamento) passa pelas API routes (Admin SDK), com
      // validação e histórico. Antes seller/admin podiam reescrever qualquer
      // campo do pedido direto, inclusive marcar como pago sem passar pelo
      // fluxo de confirmação. O front só apaga (delete abaixo).
      allow update: if false;
      // Delete: admin sempre; seller só pode deletar pedidos cancelados
      allow delete: if hasRole('admin') || (
        hasRole('seller') && resource.data.status == 'cancelled'
      );
    }

    // ── Coupons ──────────────────────────────────────────────────────────────
    match /coupons/{code} {
      // Só a equipe. Antes qualquer cliente logado listava TODOS os cupons
      // (o ID do documento é o próprio código). A validação para o cliente
      // acontece no servidor (/api/checkout/validate-coupon).
      allow read: if isSellerOrAdmin();
      allow write: if isSellerOrAdmin();
    }

    // ── Trocas e devoluções ─────────────────────────────────────────────────
    match /returns/{returnId} {
      // Cliente lê só as próprias solicitações; vendedor/admin lê todas.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isSellerOrAdmin()
      );
      // Registrado sempre pelo vendedor no painel (telefone/WhatsApp com o
      // cliente ainda é por fora), sem autoatendimento do cliente por
      // enquanto, então só seller/admin escreve.
      allow write: if isSellerOrAdmin();
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read: if true;
      // Parâmetros que movem dinheiro e os modos sandbox só o admin altera.
      // Seller continua podendo editar o resto das configurações da loja.
      // (Antes um seller podia, por exemplo, pôr 99% de desconto no PIX ou
      // ligar o modo sandbox de pagamento.)
      function moneyAndSandboxUnchanged() {
        return request.resource.data.get('abacatePaySandboxMode', false) == resource.data.get('abacatePaySandboxMode', false)
            && request.resource.data.get('uberDirectSandboxMode', false) == resource.data.get('uberDirectSandboxMode', false)
            && request.resource.data.get('pixDiscountPct', 0) == resource.data.get('pixDiscountPct', 0)
            && request.resource.data.get('pixDiscountThresholdCents', 0) == resource.data.get('pixDiscountThresholdCents', 0)
            && request.resource.data.get('freeShippingThresholdCents', 0) == resource.data.get('freeShippingThresholdCents', 0)
            && request.resource.data.get('freeShippingMaxLossCents', 0) == resource.data.get('freeShippingMaxLossCents', 0)
            && request.resource.data.get('uberOverspendMarginCents', 0) == resource.data.get('uberOverspendMarginCents', 0)
            && request.resource.data.get('creditMinOrderCents', 0) == resource.data.get('creditMinOrderCents', 0);
      }
      allow create, delete: if hasRole('admin');
      allow update: if hasRole('admin') || (hasRole('seller') && moneyAndSandboxUnchanged());
    }

    // ── Stock Alerts ─────────────────────────────────────────────────────────
    match /stockAlerts/{sku} {
      allow read, write: if isSellerOrAdmin();
    }

    // ── Notifications (subcoleção por usuário) ────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read: if isSelf(userId) || isSellerOrAdmin();
      allow write: if isSellerOrAdmin();
    }

    // ── Push tokens (FCM), só o backend (Admin SDK) acessa; nunca o client ──
    // Tokens são vinculados a seller/admin pelo endpoint /api/painel/push-token
    // (que valida a role via verifyAuth). Não expor leitura/escrita direta:
    // um vendor não deve ver ou apagar o token de outro vendor pelo client.
    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }

    // ── Maintenance, leitura pública (status), escrita só admin/seller ───────
    match /maintenance/{doc} {
      allow read: if true;
      allow write: if isSellerOrAdmin();
    }
    match /maintenance_queue/{doc} {
      // O proxy roda sem autenticação (Edge Runtime). Ele precisa:
      //  (a) LER um documento pelo ID, para saber se o IP está liberado, e
      //  (b) CRIAR o registro do visitante.
      // O ID é um HMAC do IP (64 hex, ver lib/maintenanceQueue.ts), então só
      // quem tem o segredo calcula o ID de um IP. LISTAR é só da equipe: antes
      // a coleção inteira (IP, user-agent, URL com token de reset...) era
      // legível por qualquer pessoa na internet.
      allow get: if true;
      allow list: if isSellerOrAdmin();
      // Só cria documento novo, com o formato exato que o proxy grava (campos
      // e tamanhos limitados) e released=false: visitante anônimo não se
      // auto-libera, não sobrescreve registro existente e não injeta dados.
      allow create: if doc.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['ip', 'released', 'enteredAt', 'userAgent',
             'isBot', 'referer', 'acceptLanguage', 'requestedPath', 'platform', 'isMobile'])
        && request.resource.data.released == false
        && request.resource.data.ip is string && request.resource.data.ip.size() <= 45
        && request.resource.data.enteredAt is string && request.resource.data.enteredAt.size() <= 40
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
        && request.resource.data.isBot is bool
        && request.resource.data.referer is string && request.resource.data.referer.size() <= 300
        && request.resource.data.acceptLanguage is string && request.resource.data.acceptLanguage.size() <= 100
        && request.resource.data.requestedPath is string && request.resource.data.requestedPath.size() <= 200
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 30
        && request.resource.data.isMobile is string && request.resource.data.isMobile.size() <= 10;
      // Liberar (released=true) ou apagar exige seller/admin autenticado.
      allow update, delete: if isSellerOrAdmin();
    }

    // ── Conversas de e-mail (caixa de mensagens do painel) ──────────────────
    match /conversations/{convId} {
      allow read: if isSellerOrAdmin();
      // Criação/escrita normal só via Admin SDK (webhook inbound, rota de
      // envio). O client só pode marcar como lida (unread: false), não
      // pode alterar nenhum outro campo nem criar/deletar a conversa.
      allow create, delete: if false;
      allow update: if isSellerOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);

      match /messages/{messageId} {
        allow read: if isSellerOrAdmin();
        // Escrita só via Admin SDK (webhook inbound, rota de envio).
        allow write: if false;
      }
    }

    // ── WhatsApp catalog import ──────────────────────────────────────────────
    // Sessão do WhatsApp (credenciais Baileys), equivale a estar logado na
    // conta. Acesso SOMENTE pelo Admin SDK (que ignora estas regras). Client
    // nunca lê nem escreve, nem seller/admin.
    match /whatsappAuth/{doc} {
      allow read, write: if false;
    }
    match /whatsappAuthKeys/{doc} {
      allow read, write: if false;
    }
    // Status da conexão + QR code atual, não é sensível por si só (QR
    // expira em segundos), seller/admin pode ler em tempo real pra exibir
    // na tela de importação. Escrita só pelo Admin SDK.
    match /whatsappCatalogStatus/{doc} {
      allow read: if isSellerOrAdmin();
      allow write: if false;
    }

    // ── Equipe (quem tem acesso ao painel) ───────────────────────────────────
    // Só existe pra exibição na tela de configurações. A autorização de
    // verdade nunca vem daqui, sempre do custom claim do token (ver
    // /api/painel/team). Acesso exclusivo pelo Admin SDK, direto do client
    // (mesmo admin) não lê nem escreve, pra não abrir brecha de alguém
    // editar a própria role aqui direto.
    match /team/{uid} {
      allow read, write: if false;
    }

    // ── Tudo mais: negar por padrão ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
